# Build output
work/
out/

# Downloaded packages (generated by prepare.sh)
airootfs/root/packages/

# Downloaded wallpapers (generated by prepare.sh)
airootfs/root/endeavouros-wallpaper.png
airootfs/root/livewall-original.png
# NOTE: airootfs/root/livewall.png stays TRACKED — it is the clean source
# that prepare.sh annotates in place (reset.sh restores it). A gitignore
# line would be dead config for a tracked file.

# Generated pacman mirrorlist
airootfs/etc/pacman.d/

# Built skel package (src/ stays tracked — it IS the package source that
# the PKGBUILD's package() ships; ignoring it would silently hide new skel
# files from git status)
airootfs/root/endeavouros-skel-liveuser/*.pkg.tar.xz
airootfs/root/endeavouros-skel-liveuser/*.pkg.tar.zst
airootfs/root/endeavouros-skel-liveuser/pkg/

# Build logs
eosiso*.log

# macOS Finder metadata
.DS_Store
